# Quote form delivery (src/app/api/quote/route.ts). All three are needed; without them the form
# tells visitors nothing was sent, so no lead is lost silently.
# Uses Resend (https://resend.com). Swap the fetch in the route if the client prefers another service.
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
# Public site URL for metadata, share image and structured data
NEXT_PUBLIC_SITE_URL=http://localhost:3111
